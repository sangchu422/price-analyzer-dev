# PostgreSQL 접속 정보 — 이 파일을 .env 로 복사 후 값 수정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quote_db
DB_USER=quote_app
DB_PASSWORD=your_password

# 견적서 파일이 있는 루트 폴더 (하위 폴더 포함 재귀 스캔)
QUOTE_FOLDER=D:\workroom\dev\price_analyzer_r1\견적서

# 이상가 임계값 (평균 단가 대비 초과 비율, 기본 15%)
ANOMALY_THRESHOLD=0.15

# 라인 아이템 최소 신뢰도 (표준단가 산출에 포함되는 하한선)
MIN_CONFIDENCE=0.70
