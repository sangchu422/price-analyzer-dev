# ── hChat 임베딩 API (필수) ──────────────────────────────────
H_CHAT_BASE_URL=https://internal-apigw-kr.hmg-corp.io/hchat-in/api/v3
H_CHAT_API_KEY=your-api-key-here
H_CHAT_PROJECT_ID=

# ── 견적서 원본 경로 ─────────────────────────────────────────
# 실행 환경에 맞게 직접 설정 필요
# DRM 보안해제본이 있는 경우 해당 경로로 지정
# 예) 상대경로: ../견적서
# 예) 절대경로: C:\Users\...\견적서
QUOTE_FOLDER=../견적서

# ── 비즈니스 임계값 ──────────────────────────────────────────
ANOMALY_THRESHOLD=0.15
MIN_CONFIDENCE=0.70

# ── SQLite (Codex 마이그레이션 예정) ─────────────────────────
# DB_PATH=./quote.db

# ── PostgreSQL (레거시, 삭제 예정) ───────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=quote_db
# DB_USER=quote_app
# DB_PASSWORD=your_password
