# Price Analyzer local environment template.
# Copy to `.env` at the repo root and fill in what you need.
# Never commit the real `.env` — it's gitignored on the team repo.
#
# Everything below is optional. The app runs with zero .env and
# sensible defaults (hChat off, DeviceMart on, no API keys needed).

# hChat embedding (optional): improves grouping-candidate matching.
# Endpoint/model below are the shared team values — leave them as-is.
# Each teammate enters their own personal API key in the app's
# /settings screen after starting the app, not here.
HCHAT_EMBEDDING_ENABLED=true
HCHAT_EMBEDDING_ENDPOINT=https://internal-apigw-kr.hmg-corp.io/hchat-in/api/v3/openai/deployments/text-embedding-3-large/embeddings?api-version=2024-10-21
HCHAT_EMBEDDING_MODEL=text-embedding-3-large
HCHAT_EMBEDDING_API_STYLE=custom
HCHAT_EMBEDDING_API_KEY=
HCHAT_PROJECT_ID=

# DeviceMart market-price search (public, no key required).
# Default is enabled; set to false to disable it entirely.
DEVICEMART_ENABLED=true
